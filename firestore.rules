rules_version = '2';

// Anyone with the page link can read and edit the lists, no sign-in.
// The rules only make sure every entry keeps the right shape, and nothing else can be written.
service cloud.firestore {
  match /databases/{database}/documents {

    // Who brings an item: nobody (null), one person (an id), or several people (a list of 2-4 ids).
    // 'all' is the old "everyone" value, still accepted on existing items.
    function validWho(w) {
      return w == null
        || (w is string && w in ['stav', 'shlomi', 'reshef', 'sapir', 'all'])
        || (w is list && w.size() >= 2 && w.size() <= 4
            && w.hasOnly(['stav', 'shlomi', 'reshef', 'sapir'])
            && w.toSet().size() == w.size());
    }

    function validItem(d) {
      return d.keys().hasOnly(['name', 'note', 'cat', 'order', 'who', 'done'])
        && d.keys().hasAll(['name', 'note', 'cat', 'order', 'who', 'done'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.note is string && d.note.size() <= 80
        && d.cat in ['meat', 'grill', 'kitchen', 'sides', 'drinks', 'morning', 'disposable', 'camp', 'power', 'other']
        && d.order is number
        && validWho(d.who)
        && d.done is bool;
    }

    function validPersonal(d) {
      return d.keys().hasOnly(['name', 'order'])
        && d.keys().hasAll(['name', 'order'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.order is number;
    }

    // Shared "who brings what" list.
    match /items/{itemId} {
      allow read: if true;
      allow create, update: if validItem(request.resource.data);
      allow delete: if true;
    }

    // "Everyone packs their own" list. Only the names are shared; ticks stay on each phone.
    match /personal/{itemId} {
      allow read: if true;
      allow create, update: if validPersonal(request.resource.data);
      allow delete: if true;
    }

    // One-time markers: a starting list was loaded, so it is never loaded again.
    match /meta/{marker} {
      allow read: if true;
      allow create: if marker in ['seed', 'seedPersonal']
        && request.resource.data.keys().hasOnly(['seededAt', 'count']);
    }
  }
}
